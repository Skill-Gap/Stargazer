PORT=3000
PI_API_URL=http://pi-host:8000
UPSTREAM_TIMEOUT_MS=5000

# Optional workstation reachability targets. Tailscale is tried before local.
DESKTOP_TAILSCALE_HOST=desktop-tailnet-host
DESKTOP_LOCAL_HOST=desktop-lan-host
LAPTOP_TAILSCALE_HOST=laptop-tailnet-host
LAPTOP_LOCAL_HOST=laptop-lan-host

HA_URL=http://home-assistant-host:8123
HA_TOKEN=replace-with-a-long-lived-access-token
PI_PLUG_ENTITY=switch.pi_socket_1
DESKTOP_PLUG_ENTITY=switch.desktop_socket_1
LAMP_ENTITY=switch.lamp_socket_1

# Optional comma-separated origins for a separately hosted frontend.
ALLOWED_ORIGINS=http://localhost:3000

# Used only by the legacy GET /status/pi route.
PI_TAILSCALE_IP=100.0.0.1
PI_LOCAL_IP=192.0.2.10
